# DMR HHPC Fault Diagnosis Chatbot — Environment Config
# Copy this to .env and edit as needed.

# ── Tier 1 ──────────────────────────────────────────────
# Classifier confidence below this escalates to Tier 2
TIER1_CONFIDENCE_THRESHOLD=0.3

# ── Tier 2 — LLM Backend ────────────────────────────────
# Options: "ollama" | "llamacpp" | "none"
LLM_BACKEND=ollama

# Ollama model name (if LLM_BACKEND=ollama)
LLM_MODEL=phi3:mini

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Path to GGUF file (if LLM_BACKEND=llamacpp)
LLM_MODEL_PATH=models/phi-3-mini-q4.gguf

# LLM generation settings
LLM_TIMEOUT=60
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── Tier 2 — RAG (LangChain + FAISS) ───────────────────
RAG_TOP_K=4
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
